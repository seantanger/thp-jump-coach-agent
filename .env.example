# Copy to .env and fill in. Never commit .env.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Model per agent role: "<provider>:<model>" ---
# Claude (main):    anthropic:claude-sonnet-5-5 | anthropic:claude-haiku-5-5 | anthropic:claude-opus-5-5
# Ollama (local):   ollama:qwen3:4b
DEFAULT_MODEL=anthropic:claude-sonnet-5-5
COACH_MODEL=anthropic:claude-sonnet-5-5
PLANNER_MODEL=anthropic:claude-sonnet-5-5
VERIFIER_MODEL=anthropic:claude-sonnet-5-5
SAFETY_MODEL=anthropic:claude-haiku-5-5
ROUTER_MODEL=anthropic:claude-haiku-5-5

# --- Generation / timeouts ---
# Leave unset to use each model's default. Sonnet 5.5 and Fable 5 reject any
# non-default temperature, so only set this for models that accept it.
# LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
# Ollama is CPU-only on an Intel Mac: give it minutes, not seconds.
OLLAMA_TIMEOUT_S=600
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b is a thinking-only build: true keeps its reasoning out of the answer text.
# Set false only for local models without thinking support.
OLLAMA_REASONING=true

# --- Embeddings: "<provider>:<model>", built by get_embeddings() ---
EMBEDDING_MODEL=ollama:nomic-embed-text

# --- Private transcript data (read in place, never copied into this repo) ---
# Reads $THP_DATA_DIR/clean/<channel>/<video_id>.json, writes $THP_DATA_DIR/chunks/.
THP_DATA_DIR=~/git/thp-ai/data

# --- scripts/compare_models.py ---
COMPARE_MODELS=anthropic:claude-sonnet-5-5,ollama:qwen3:4b
